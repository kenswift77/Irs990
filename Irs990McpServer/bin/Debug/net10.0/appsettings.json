{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // -----------------------------------------------------------------------
  // Connection string — set in App Service → Configuration → Connection Strings
  // Name must be "Irs990Db".
  //
  // With Managed Identity (recommended for production):
  //   Server=<server>.database.windows.net;Database=<db>;
  //   Authentication=Active Directory Default;Encrypt=True;
  //   (UseManagedIdentity must be true)
  //
  // With SQL auth (local dev / quick test):
  //   Server=<server>.database.windows.net;Database=<db>;
  //   User Id=<user>;Password=<pwd>;Encrypt=True;
  // -----------------------------------------------------------------------
  "ConnectionStrings": {
    "Irs990Db": ""
  },

  // Set to true when the App Service has a System-Assigned or User-Assigned
  // Managed Identity with the "db_datareader" role on the Azure SQL database.
  // Set to false for SQL-auth connections (local dev, password in conn string).
  "UseManagedIdentity": false,

  // Optional — Application Insights connection string.
  // Leave blank to disable telemetry.
  "ApplicationInsights": {
    "ConnectionString": ""
  },

  "AllowedHosts": "*"
}
